# Factory Deck — environment
#
# ONE AUTOMATIC MODEL LADDER FOR BUILD WORK. Every live run starts at the
# strongest configured paid rung, demotes only when that model/provider is
# exhausted, and finishes at the strongest available free/local rotation.
# There is no owner-selected Free route or Paid route.
#
# MANDATORY PRODUCTION REVIEWS. Every non-demo Factory Deck run and Purpose
# Foundry project requires two independent judgments over the exact evidence.
# Both calls start at the strongest configured paid rung and descend the same
# paid ladder; no provider-family side route can deadlock completion.

# ---- Final free/local ladder rung -----------------------------------------
FACTORY_FREE_ENABLED=1
FACTORY_FREE_BASE_URL=http://127.0.0.1:8082
# Bearer token the FCC proxy expects (its ANTHROPIC_AUTH_TOKEN).
FACTORY_FREE_AUTH_TOKEN=freecc
# A Claude-shaped id the proxy maps onto its free backend. "sonnet" lands on
# the proxy's strong tier (glm-5.2 here); "haiku" lands on a much weaker one.
FACTORY_FREE_MODEL=claude-sonnet-4-5
# Used only for out-of-band liveness evidence, never for model calls.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Mirror of the proxy's PROVIDER_MAX_CONCURRENCY — drives queue-depth patience.
FACTORY_FREE_MAX_CONCURRENCY=2
# After a PROVEN stall, skip the free route this long, then re-probe it.
FACTORY_FREE_HOLD_MS=300000
FACTORY_FREE_ATTEMPTS=3
FACTORY_FREE_RETRY_SPACING_MS=6000
FACTORY_FREE_BACKPRESSURE_RETRIES=20
FACTORY_FREE_AUTORESTART=1

# ---- Stall thresholds (leave unset; they are MEASURED) --------------------
# Derived from .factory/free-route-calibration.json, written by
#   node scripts/measure-free-route.mjs
# Measured on this host 2026-08-11 over 8 healthy calls:
#   first-token silence  p50 211.1s  p95 302.3s  max 302.3s
#   inter-token silence  p50  10ms   p95  41ms   max  244ms
# Those two distributions differ by ~1,239x, which is why they get separate
# budgets. Setting these by hand re-introduces the constant that caused the
# problem — only override to make a stall reproduce in a test.
# FACTORY_FREE_FIRST_TOKEN_WINDOW_MS=
# FACTORY_FREE_IDLE_GAP_MS=
# FACTORY_FREE_BACKSTOP_MS=3600000
# FACTORY_FREE_PATIENCE_GRANTS=3

# ---- Paid ladder rungs + mandatory production reviews ---------------------
# Configure either or both paid providers. Both readiness judgments use the
# same paid-first ladder and independently descend when a model is exhausted.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ordinary paid build/review models.
ANTHROPIC_MODEL=claude-fable-5-1
# Strongest-to-weakest models inside the Anthropic paid rung. Exhausted models
# stay demoted for the rest of the run before the orchestrator reaches OpenAI.
FACTORY_ANTHROPIC_MODEL_LADDER=claude-fable-5-1,claude-opus-5,claude-sonnet-5,claude-haiku-4-5
OPENAI_MODEL=gpt-5.5

# Compatibility model preferences retained for existing deployments. The
# OpenAI readiness rung uses FACTORY_SOL_MODEL; Anthropic readiness uses the
# full strongest-to-weakest FACTORY_ANTHROPIC_MODEL_LADDER. Neither reviewer
# may fall through to free, mock, or stub capacity.
FACTORY_SOL_MODEL=gpt-5.5
FACTORY_FABLE_OR_OPUS_MODEL=claude-fable-5-1

# ---- Paid-call admission guards -------------------------------------------
# The call counts are hard admission limits within one Factory Node process.
# The USD figure is only a local estimate from token usage and global rates;
# it is not an invoice or a hard actual-spend cap. Provider/model pricing,
# cache/reasoning/tool charges, failed requests, and multiple processes can
# differ. Use provider-native account caps for a hard actual-dollar guarantee.
# Caps are owner opt-in; absent means unlimited. Example values only:
# FACTORY_PAID_RESCUES_PER_HOUR=6
# FACTORY_PAID_RESCUES_PER_DAY=24
# FACTORY_PAID_MAX_USD_PER_DAY=2
FACTORY_PAID_USD_PER_MTOK_IN=20
FACTORY_PAID_USD_PER_MTOK_OUT=100

# ---- Automatic model ladder -----------------------------------------------
# Provider-family order after the Anthropic model ladder above. Missing or
# unconfigured paid rungs are skipped; ordinary work appends free/local last.
# Mandatory readiness uses this same order but remains paid-only.
FACTORY_MODEL_LADDER=anthropic,openai
# Legacy compatibility fields only; current live work ignores them.
DEFAULT_CODE_PROVIDER=free
DEFAULT_REVIEW_PROVIDER=free

# ---- Competitive research -------------------------------------------------
FACTORY_RESEARCH_ENABLED=1
# Firecrawl v2 is tried first. A key raises service limits; when blank, Factory
# Deck attempts keyless Firecrawl and then falls back honestly to DuckDuckGo.
FIRECRAWL_API_KEY=

# ---- Run limits -----------------------------------------------------------
MAX_REPAIR_LOOPS=3
MAX_MODEL_CALLS_PER_RUN=30
# Sized for the free route (a single free call takes minutes). 0 disables.
FACTORY_RUN_TIMEOUT_MS=14400000
WORKSPACE_ROOT=./workspaces
# Generated projects and their dependencies are untrusted. This switch is only
# an execution gate; it does NOT create an OS-level filesystem/network sandbox.
# Leave it false unless Factory Deck itself is running inside a disposable
# container/VM with a workspace-only writable mount and no host secrets.
ALLOW_UNTRUSTED_SCRIPTS=false

# Optional: backend port (frontend proxies /api here). Defaults to 5179.
PORT=5179

# Optional: require bearer token for API (required if FACTORY_BIND_LAN=1).
# FACTORY_AUTH_TOKEN=
# FACTORY_BIND_LAN=0

# Optional: absolute path to an Obsidian folder watched by Purpose Foundry.
# PURPOSE_FOUNDRY_OBSIDIAN_INBOX=C:\Users\YourUserName\Documents\Obsidian Vault\Purpose Foundry

# Purpose Foundry specialist adapters
PURPOSE_FOUNDRY_REPO_REWARDS_URL=https://web-production-d7db7.up.railway.app
PURPOSE_FOUNDRY_PROMOPILOT_URL=https://promopilot-production-6370.up.railway.app
# PURPOSE_FOUNDRY_PROMOPILOT_TOKEN=
# PURPOSE_FOUNDRY_APP_STORE_PUBLISHER_URL=http://127.0.0.1:4000
# Safe Google default. Set production explicitly to authorize a production-track release.
PURPOSE_FOUNDRY_GOOGLE_PLAY_TRACK=internal
# Optional Galaxy fallback when the listing has no existing gms value: Y or N.
# PURPOSE_FOUNDRY_GALAXY_GMS=N
# Publisher upload + store processing may take hours.
PURPOSE_FOUNDRY_PUBLISH_TIMEOUT_MS=14400000
PURPOSE_FOUNDRY_FLEXFACTOR_SCRIPT=C:\\Users\\firer\\flexfactor\\flexfactor.py
PURPOSE_FOUNDRY_PYTHON=python
PURPOSE_FOUNDRY_FLEXFACTOR_MAX_COST=150
# PURPOSE_FOUNDRY_ALLOW_REMOTE_PROGRAM_CONTEXT=0
# PURPOSE_FOUNDRY_WATCH_URLS=https://your-app.example/health

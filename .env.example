# Paid keys are REQUIRED for live factory journeys (purpose contract v0.2).
# Offline mock/demo works only with explicit --demo / options.demo=true.
# Mock success alone is NOT Production Ready / purpose fulfillment.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-5.5
DEFAULT_CODE_PROVIDER=anthropic
DEFAULT_REVIEW_PROVIDER=openai
MAX_REPAIR_LOOPS=3
MAX_MODEL_CALLS_PER_RUN=30
# Overall run wall-clock timeout (ms). 0 disables.
FACTORY_RUN_TIMEOUT_MS=600000
WORKSPACE_ROOT=./workspaces
DRY_RUN_COMMANDS=true
# Explicit approval required to execute model-authored scripts when dry-run is off.
ALLOW_UNTRUSTED_SCRIPTS=false

# Optional: backend port (frontend proxies /api here). Defaults to 5179.
PORT=5179

# Optional: require bearer token for API (required if FACTORY_BIND_LAN=1).
# FACTORY_AUTH_TOKEN=
# FACTORY_BIND_LAN=0

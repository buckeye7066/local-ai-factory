# Factory Deck / local-ai-factory environment
# Copy this file to .env and fill in your real keys. NEVER commit .env.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-5.5
DEFAULT_CODE_PROVIDER=anthropic
DEFAULT_REVIEW_PROVIDER=openai
MAX_REPAIR_LOOPS=3
MAX_MODEL_CALLS_PER_RUN=30
WORKSPACE_ROOT=./workspaces
DRY_RUN_COMMANDS=true

# Optional: backend port (frontend proxies /api here). Defaults to 5179.
PORT=5179

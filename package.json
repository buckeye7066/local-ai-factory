{
  "name": "local-ai-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "description": "Factory Deck — a local-first AI software factory that builds apps through an agent assembly line.",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "~1.20.6",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.23": ">=8.5.26",
      "shell-quote@<1.8.5": ">=1.8.5",
      "esbuild@<0.25.0": ">=0.25.0",
      "browserslist@<=4.28.6": "4.28.7",
      "qs@<6.16.0": "6.16.0"
    }
  },
  "scripts": {
    "dev": "concurrently -n server,ui -c blue,magenta \"node --import tsx src/server/index.ts\" \"vite\"",
    "server": "node --import tsx src/server/index.ts",
    "server:watch": "node --import tsx --watch src/server/index.ts",
    "start": "vite build && node --import tsx src/server/index.ts",
    "ui": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "factory": "tsx src/cli/factory.ts",
    "proof:real-provider": "tsx src/cli/proof-real-provider.ts",
    "proof:free-route": "tsx src/cli/proof-free-route.ts",
    "rotation:pin": "tsx src/cli/rotation-pin.ts",
    "glimmer": "tsx src/cli/glimmer.ts",
    "proof:rotation": "tsx scripts/smoke-rotation.ts",
    "proof:extend-futureu": "tsx src/cli/proof-extend-futureu.ts",
    "measure:free-route": "node scripts/measure-free-route.mjs",
    "release:check": "node scripts/release-check.mjs",
    "icon": "tsx scripts/make-icon.ts",
    "install:desktop-icon": "powershell -NoLogo -NoProfile -File scripts/Install-Desktop-Icon.ps1",
    "test": "vitest run",
    "test:release-gates": "vitest run src/server/__tests__/liveNoMockFallback.test.ts src/server/__tests__/productSpecCoercion.test.ts src/server/__tests__/mockProductionReady.test.ts src/server/__tests__/providers.test.ts src/server/__tests__/stubRun.test.ts src/server/__tests__/cancellation.test.ts src/server/__tests__/commandSandbox.test.ts src/server/__tests__/commandEnvHardening.test.ts",
    "test:production-ready": "pnpm test:release-gates",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "lint:changed": "node scripts/lint-changed.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "install:purpose-foundry-icon": "powershell -NoLogo -NoProfile -File scripts/Install-Purpose-Foundry-Icon.ps1",
    "memory:startup": "node scripts/obsidian-memory.mjs startup",
    "memory:health": "node scripts/obsidian-memory.mjs health",
    "memory:recall": "node scripts/obsidian-memory.mjs recall",
    "memory:note": "node scripts/obsidian-memory.mjs note",
    "predev": "npm run memory:startup",
    "prestart": "npm run memory:startup",
    "prebuild": "npm run memory:startup"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "happy-dom": "^20.11.2",
    "openai": "^4.83.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.474.0",
    "postcss": "^8.5.1",
    "prettier": "3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.0.5"
  }
}

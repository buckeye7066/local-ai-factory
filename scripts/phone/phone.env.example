# Factory Deck — ON-DEVICE (Android/Termux) configuration.
#
# The point of this file is INDEPENDENCE: nothing here may point at the laptop.
# Copy to `.env` in the repo root on the phone and fill in a key.

# ---- Provider ------------------------------------------------------------
# The desktop .env routes everything through the FCC free proxy at
# http://127.0.0.1:8082. On the phone that address is the PHONE's loopback, so
# it only works if FCC is ALSO installed and running in Termux. It is not
# installed by scripts/phone/setup.sh, so the on-device default is the paid
# provider — chosen because it is the only one that is actually true here.
#
# THIS COSTS MONEY. If you want the free route on the phone, install FCC in
# Termux, then set FACTORY_FREE_ENABLED=1 and the three FACTORY_FREE_* values
# from the desktop .env. Do not enable it "hopefully" — an unreachable free
# route just burns the run's timeout before falling back.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
DEFAULT_CODE_PROVIDER=anthropic
DEFAULT_REVIEW_PROVIDER=anthropic
FACTORY_FREE_ENABLED=0

# Optional second provider.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra

# ---- Blast radius --------------------------------------------------------
# A phone is easy to leave running in a pocket. Keep the daily cap low here.
FACTORY_PAID_MAX_USD_PER_DAY=2
FACTORY_PAID_RESCUES_PER_HOUR=6
FACTORY_PAID_RESCUES_PER_DAY=24
FACTORY_PAID_USD_PER_MTOK_IN=20
FACTORY_PAID_USD_PER_MTOK_OUT=100
MAX_REPAIR_LOOPS=3
MAX_MODEL_CALLS_PER_RUN=100

# ---- Local -------------------------------------------------------------
PORT=5179
WORKSPACE_ROOT=./workspaces

# Loopback-only is the on-device default and should stay that way: the console
# runs on this same phone, so binding the LAN buys nothing and exposes run
# history on every network the phone joins. Do NOT set FACTORY_BIND_LAN here.

# Phones are slower than the desk. A run that would take 40 minutes on the PC
# is not wedged at 90 minutes here.
FACTORY_RUN_TIMEOUT_MS=14400000

# ---- GitHub delivery -----------------------------------------------------
# `gh auth login` in Termux (setup.sh does this) supplies the credential; this
# only names the account a new repo is created under.
FACTORY_GITHUB_OWNER=buckeye7066

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buckeye7066/local-ai-factory/docs/release-manifest.schema.json",
  "title": "FactoryDeckReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program",
    "repo",
    "default_branch",
    "main_sha",
    "generated_at",
    "status",
    "purpose_contract_version",
    "purpose_contract_path",
    "blockers",
    "gates",
    "reviews",
    "proofs",
    "mock_only_core",
    "sha_match"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "program": { "type": "string" },
    "repo": { "type": "string" },
    "default_branch": { "type": "string" },
    "main_sha": { "type": "string", "minLength": 7 },
    "worktree_sha": { "type": ["string", "null"] },
    "deployed_sha": { "type": ["string", "null"] },
    "launcher_sha": { "type": ["string", "null"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["IN PROGRESS", "BLOCKED", "RELEASE CANDIDATE", "PRODUCTION READY"]
    },
    "purpose_contract_version": { "type": "string" },
    "purpose_contract_path": { "type": "string" },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_check",
        "production_readiness_workflow",
        "purpose_contract",
        "typecheck",
        "unit_tests",
        "real_provider_proof"
      ],
      "properties": {
        "release_check": { "type": "boolean" },
        "production_readiness_workflow": { "type": "boolean" },
        "purpose_contract": { "type": "boolean" },
        "typecheck": { "type": "boolean" },
        "unit_tests": { "type": "boolean" },
        "real_provider_proof": { "type": "boolean" }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional", "security", "release"],
      "properties": {
        "functional": {
          "type": "string",
          "enum": ["pending", "pass", "fail"]
        },
        "security": {
          "type": "string",
          "enum": ["pending", "pass", "fail"]
        },
        "release": {
          "type": "string",
          "enum": ["pending", "pass", "fail"]
        }
      }
    },
    "proofs": {
      "type": "object",
      "additionalProperties": true
    },
    "mock_only_core": { "type": "boolean" },
    "sha_match": { "type": "boolean" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

+  phase: "choosing" | "owner";
+  pid: number;
+  token: string;
+  ticket: number | null;
+  createdAt: number;
+};
+
+type ScanResult = {
+  choosing: Contender[];
+  owners: Contender[];
+  uncertain: boolean;
+};
+
+function queuePath(lockPath: string): string {
+  return `${resolve(lockPath)}.owners`;
+}
+
+function choosingName(pid: number, token: string): string {
+  return `choosing.${pid}.${token}.json`;
+}
+
+function ownerName(ticket: number, pid: number, token: string): string {
+  return `owner.${String(ticket).padStart(12, "0")}.${pid}.${token}.json`;
+}
+
+function processIsAlive(pid: number): boolean {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (error) {
+    const code = (error as NodeJS.ErrnoException).code;
+    return code !== "ESRCH" && code !== "EINVAL";
+  }
+}
+
+async function syncDirectory(path: string): Promise<void> {
+  if (process.platform === "win32") return;
+  const handle = await open(path, FS.O_RDONLY);
+  try {
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+}
+
+async function ensureQueue(path: string): Promise<void> {
+  await mkdir(path, { recursive: true });
+  const queueStat = await lstat(path);
+  if (queueStat.isSymbolicLink() || !queueStat.isDirectory()) {
+    throw new Error("Refused: process-lock queue is not a real directory.");
+  }
+}
+
+async function writeExclusiveReceipt(
+  path: string,
+  receipt: ContenderReceipt,
+): Promise<void> {
+  const flags =
+    FS.O_WRONLY | FS.O_CREAT | FS.O_EXCL | (HAS_NOFOLLOW ? FS.O_NOFOLLOW : 0);
+  const handle = await open(path, flags, 0o600);
+  try {
+    await handle.writeFile(JSON.stringify(receipt), "utf8");
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+}
+
+function parseFilename(
+  name: string,
+): Pick<Contender, "phase" | "pid" | "token" | "ticket"> | null {
+  const choosing = CHOOSING_PATTERN.exec(name);
+  if (choosing) {
+    const pid = Number(choosing[1]);
+    const token = choosing[2]!;
+    if (!Number.isSafeInteger(pid) || pid <= 0 || !UUID_PATTERN.test(token)) {
+      return null;
+    }
+    return { phase: "choosing", pid, token, ticket: null };
+  }
+  const owner = OWNER_PATTERN.exec(name);
+  if (owner) {
+    const ticket = Number(owner[1]);
+    const pid = Number(owner[2]);
+    const token = owner[3]!;
+    if (
+      !Number.isSafeInteger(ticket) ||
+      ticket <= 0 ||
+      ticket > MAX_SAFE_TICKET ||
+      !Number.isSafeInteger(pid) ||
+      pid <= 0 ||
+      !UUID_PATTERN.test(token)
+    ) {
+      return null;
+    }
+    return { phase: "owner", pid, token, ticket };
+  }
+  return null;
+}
+
+function parseReceipt(
+  raw: string,
+  filename: NonNullable<ReturnType<typeof parseFilename>>,
+): ContenderReceipt | null {
+  try {
+    const value = JSON.parse(raw) as Partial<ContenderReceipt>;
+    if (
+      value.version !== 1 ||
+      value.phase !== filename.phase ||
+      value.pid !== filename.pid ||
+      value.token !== filename.token ||
+      value.ticket !== filename.ticket ||
+      typeof value.createdAt !== "number" ||
+      !Number.isFinite(value.createdAt)
+    ) {
+      return null;
+    }
+    return value as ContenderReceipt;
+  } catch {
+    return null;
+  }
+}
+
+async function readReceipt(path: string): Promise<{ raw: string; mtimeMs: number }> {
+  const flags = FS.O_RDONLY | (HAS_NOFOLLOW ? FS.O_NOFOLLOW : 0);
+  const handle = await open(path, flags);
+  try {
+    const fileStat = await handle.stat();
+    if (!fileStat.isFile()) {
+      throw new Error("Refused: process-lock contender is not a regular file.");
+    }
+    return { raw: await handle.readFile("utf8"), mtimeMs: fileStat.mtimeMs };
+  } finally {
+    await handle.close();
+  }
+}
+
+async function removeUniqueContender(path: string, queue: string): Promise<void> {
+  // The pathname contains a random UUID generated by its sole owner. A later
+  // legitimate contender never reuses it, so removing this exact name cannot
+  // erase a replacement owner.
+  await rm(path, { force: true });
+  await syncDirectory(queue);
+}
+
+async function scanQueue(queue: string, staleGraceMs: number): Promise<ScanResult> {
+  const choosing: Contender[] = [];
+  const owners: Contender[] = [];
+  let uncertain = false;
+  const names = await readdir(queue);
+
+  for (const name of names) {
+    const filename = parseFilename(name);
+    if (!filename) continue;
+    const path = resolve(queue, name);
+    let read: { raw: string; mtimeMs: number };
+    try {
+      read = await readReceipt(path);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "ENOENT") continue;
+      throw error;
+    }
+    const receipt = parseReceipt(read.raw, filename);
+    const ageMs = Date.now() - (receipt?.createdAt ?? read.mtimeMs);
+    if (!receipt) {
+      if (ageMs >= staleGraceMs) {
+        await removeUniqueContender(path, queue);
+      } else {
+        // A creator may be between O_EXCL creation and its fsynced write.
+        uncertain = true;
+      }
+      continue;
+    }
+    if (ageMs >= staleGraceMs && !processIsAlive(receipt.pid)) {
+      await removeUniqueContender(path, queue);
+      continue;
+    }
+    const contender: Contender = {
+      path,
+      phase: receipt.phase,
+      pid: receipt.pid,
+      token: receipt.token,
+      ticket: receipt.ticket,
+      createdAt: receipt.createdAt,
+    };
+    if (contender.phase === "choosing") choosing.push(contender);
+    else owners.push(contender);
+  }
+
+  return { choosing, owners, uncertain };
+}
+
+function precedes(left: Contender, right: Contender): boolean {
+  if (left.ticket === null || right.ticket === null) return false;
+  if (left.ticket !== right.ticket) return left.ticket < right.ticket;
+  return left.token.localeCompare(right.token) < 0;
+}
+
+/**
+ * Acquire a crash-recoverable cross-process lease, or return null on timeout.
+ */
+export async function acquireProcessFileLock(
+  lockPath: string,
+  options: ProcessFileLockOptions = {},
+): Promise<ProcessFileLease | null> {
+  const timeoutMs = options.timeoutMs ?? 10_000;
+  const pollMs = options.pollMs ?? 5;
+  const staleGraceMs = options.staleGraceMs ?? 30_000;
+  if (!Number.isFinite(timeoutMs) || timeoutMs < 0) {
+    throw new TypeError("process-lock timeout must be a non-negative number");
+  }
+  if (!Number.isFinite(pollMs) || pollMs < 1) {
+    throw new TypeError("process-lock poll interval must be at least 1 ms");
+  }
+  if (!Number.isFinite(staleGraceMs) || staleGraceMs < 0) {
+    throw new TypeError("process-lock stale grace must be a non-negative number");
+  }
+
+  const queue = queuePath(lockPath);
+  await ensureQueue(queue);
+  const token = randomUUID();
+  const createdAt = Date.now();
+  const choosingPath = resolve(queue, choosingName(process.pid, token));
+  let ownerPath: string | null = null;
+  let leaseReturned = false;
+
+  try {
+    await writeExclusiveReceipt(choosingPath, {
+      version: 1,
+      phase: "choosing",
+      pid: process.pid,
+      createdAt,
+      token,
+      ticket: null,
+    });
+    await syncDirectory(queue);
+
+    const initial = await scanQueue(queue, staleGraceMs);
+    const highestTicket = initial.owners.reduce(
+      (highest, owner) => Math.max(highest, owner.ticket ?? 0),
+      0,
+    );
+    if (highestTicket >= MAX_SAFE_TICKET) {
+      throw new Error("Refused: process-lock ticket space is exhausted.");
+    }
+    const ticket = highestTicket + 1;
+    ownerPath = resolve(queue, ownerName(ticket, process.pid, token));
+    await writeExclusiveReceipt(ownerPath, {
+      version: 1,
+      phase: "owner",
+      pid: process.pid,
+      createdAt,
+      token,
+      ticket,
+    });
+    await syncDirectory(queue);
+    await removeUniqueContender(choosingPath, queue);
+
+    const self: Contender = {
+      path: ownerPath,
+      phase: "owner",
+      pid: process.pid,
+      token,
+      ticket,
+      createdAt,
+    };
+    const deadline = Date.now() + timeoutMs;
+    for (;;) {
+      const state = await scanQueue(queue, staleGraceMs);
+      const selfPresent = state.owners.some((owner) => owner.token === token);
+      if (!selfPresent) {
+        throw new Error("Refused: process-lock ownership receipt disappeared.");
+      }
+      const anotherChoosing = state.choosing.some(
+        (contender) => contender.token !== token,
+      );
+      const earlierOwner = state.owners.some(
+        (owner) => owner.token !== token && precedes(owner, self),
+      );
+      if (!state.uncertain && !anotherChoosing && !earlierOwner) {
+        let released = false;
+        leaseReturned = true;
+        return {
+          token,
+          release: async () => {
+            if (released) return;
+            released = true;
+            if (ownerPath) await removeUniqueContender(ownerPath, queue);
+            await rm(choosingPath, { force: true });
+          },
+        };
+      }
+      if (Date.now() >= deadline) return null;
+      await new Promise((resolveWait) => setTimeout(resolveWait, pollMs));
+    }
+  } finally {
+    // On a successful acquisition, the returned release closure owns ownerPath.
+    // On timeout or error, no queue entry from this contender may survive.
+    if (!leaseReturned && ownerPath) {
+      await removeUniqueContender(ownerPath, queue).catch(() => {});
+    }
+    if (!leaseReturned) await rm(choosingPath, { force: true });
+  }
+}
+
+export function _processLockQueuePathForTests(lockPath: string): string {
+  return queuePath(lockPath);
+}

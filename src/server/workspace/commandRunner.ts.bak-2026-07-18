import { spawn } from "node:child_process";
import { resolve, relative, isAbsolute } from "node:path";

/**
 * commandRunner.ts — conservative command execution.
 *
 * SECURITY BOUNDARY:
 *  - Only an explicit ALLOWLIST of package-manager subcommands may run, and
 *    only inside a workspace directory (never the project root).
 *  - When DRY_RUN_COMMANDS is true, commands are NOT executed — we only report
 *    what *would* run. This is the default, so a fresh checkout never runs
 *    model-authored code by accident.
 *  - Arbitrary shell strings are never accepted: callers pass an argv array,
 *    `shell` is disabled, so there is no shell-injection surface.
 */

/** (binary, firstArg) pairs that are permitted. */
const ALLOWLIST: ReadonlyArray<readonly [string, string]> = [
  ["npm", "install"],
  ["npm", "ci"],
  ["npm", "run"],
  ["npm", "test"],
  ["pnpm", "install"],
  ["pnpm", "run"],
  ["pnpm", "test"],
  ["pnpm", "build"],
  ["pnpm", "typecheck"],
  ["yarn", "install"],
  ["yarn", "test"],
  ["npx", "tsc"],
];

export interface CommandRequest {
  bin: string;
  args: string[];
  /** Absolute path to the workspace this command runs in. */
  cwd: string;
}

export interface CommandResult {
  command: string;
  allowed: boolean;
  executed: boolean;
  exitCode: number | null;
  stdout: string;
  stderr: string;
  reason?: string;
}

export function isAllowed(bin: string, args: string[]): boolean {
  const first = args[0] ?? "";
  return ALLOWLIST.some(([b, a]) => b === bin && a === first);
}

/**
 * Windows can only execute .cmd shims (pnpm/npm/yarn/npx) through cmd.exe —
 * Node rejects them with EINVAL when `shell` is false. On win32 we therefore
 * spawn with `shell: true`, but ONLY after verifying every argv token against
 * a strict character allowlist so no shell metacharacter can ever reach cmd.
 * On POSIX we keep `shell: false` (no shell at all).
 */
const SAFE_ARG = /^[A-Za-z0-9._:@\/=-]+$/;

export function argsAreShellSafe(bin: string, args: string[]): boolean {
  return [bin, ...args].every((a) => SAFE_ARG.test(a));
}

/** True only when `cwd` is strictly inside `workspaceRoot`. */
export function isInsideWorkspace(workspaceRoot: string, cwd: string): boolean {
  const root = resolve(workspaceRoot);
  const target = resolve(cwd);
  const rel = relative(root, target);
  return !rel.startsWith("..") && !isAbsolute(rel);
}

export interface RunCommandOptions {
  workspaceRoot: string;
  dryRun: boolean;
  timeoutMs?: number;
}

/**
 * Run a command subject to the allowlist, workspace jail, and dry-run flag.
 * Returns a structured result instead of throwing on non-zero exit, so the
 * orchestrator can feed failures to the QA/repair agents.
 */
export async function runCommand(
  req: CommandRequest,
  opts: RunCommandOptions,
): Promise<CommandResult> {
  const command = `${req.bin} ${req.args.join(" ")}`.trim();

  if (!isAllowed(req.bin, req.args)) {
    return {
      command,
      allowed: false,
      executed: false,
      exitCode: null,
      stdout: "",
      stderr: "",
      reason: `Command not in allowlist: ${command}`,
    };
  }

  if (!isInsideWorkspace(opts.workspaceRoot, req.cwd)) {
    return {
      command,
      allowed: false,
      executed: false,
      exitCode: null,
      stdout: "",
      stderr: "",
      reason: "Refused: command cwd is outside the workspace boundary.",
    };
  }

  // DRY RUN: report intent, do not execute.
  if (opts.dryRun) {
    return {
      command,
      allowed: true,
      executed: false,
      exitCode: null,
      stdout: "",
      stderr: "",
      reason: `DRY_RUN_COMMANDS=true — would run: ${command}`,
    };
  }

  const useShell = process.platform === "win32";
  if (useShell && !argsAreShellSafe(req.bin, req.args)) {
    return {
      command,
      allowed: false,
      executed: false,
      exitCode: null,
      stdout: "",
      stderr: "",
      reason: "Refused: command arguments contain unsafe characters.",
    };
  }

  return new Promise<CommandResult>((resolveP) => {
    const child = spawn(req.bin, req.args, {
      cwd: req.cwd,
      // POSIX: no shell → no injection surface. Windows: .cmd shims require a
      // shell (Node EINVAL otherwise); argv was validated by argsAreShellSafe.
      shell: useShell,
      env: { ...process.env },
    });
    let stdout = "";
    let stderr = "";
    const timeout = setTimeout(() => {
      child.kill("SIGKILL");
    }, opts.timeoutMs ?? 120_000);

    child.stdout.on("data", (d) => (stdout += d.toString()));
    child.stderr.on("data", (d) => (stderr += d.toString()));
    child.on("error", (err) => {
      clearTimeout(timeout);
      resolveP({
        command,
        allowed: true,
        executed: false,
        exitCode: null,
        stdout,
        stderr: String(err),
        reason: "spawn error",
      });
    });
    child.on("close", (code) => {
      clearTimeout(timeout);
      resolveP({
        command,
        allowed: true,
        executed: true,
        exitCode: code,
        stdout: stdout.slice(-8000),
        stderr: stderr.slice(-8000),
      });
    });
  });
}

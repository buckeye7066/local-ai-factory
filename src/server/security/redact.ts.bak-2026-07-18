/**
 * security/redact.ts — mask secret-shaped substrings before they are written to
 * the DURABLE run log / persisted record. A user (or an injected intake) can
 * paste an API key or a `.env` line; without this it would be persisted in
 * `.factory/runs/<id>.json` and served over the API. Redaction is conservative:
 * it targets recognizable credential shapes so ordinary prose is untouched.
 */

const PATTERNS: ReadonlyArray<{ re: RegExp; label: string }> = [
  {
    re: /-----BEGIN (?:[A-Z ]+ )?PRIVATE KEY-----[\s\S]*?-----END (?:[A-Z ]+ )?PRIVATE KEY-----/g,
    label: "PRIVATE_KEY",
  },
  // OpenAI / Anthropic style: sk-..., sk-ant-...
  { re: /\bsk-(?:ant-)?[A-Za-z0-9_-]{16,}\b/g, label: "API_KEY" },
  // Slack tokens
  { re: /\bxox[baprs]-[A-Za-z0-9-]{10,}\b/g, label: "SLACK_TOKEN" },
  // GitHub tokens (ghp_, gho_, ghs_, ghr_, ghu_)
  { re: /\bgh[posru]_[A-Za-z0-9]{20,}\b/g, label: "GITHUB_TOKEN" },
  // AWS access key id
  { re: /\bAKIA[0-9A-Z]{16}\b/g, label: "AWS_KEY" },
  // JWTs (three base64url segments)
  {
    re: /\beyJ[A-Za-z0-9_-]{6,}\.[A-Za-z0-9_-]{6,}\.[A-Za-z0-9_-]{6,}\b/g,
    label: "JWT",
  },
];

// `.env`-style KEY=VALUE where the NAME looks like a secret.
const ENV_SECRET =
  /\b([A-Za-z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|PRIVATE)[A-Za-z0-9_]*)(\s*[:=]\s*)(["']?)([^\s"']+)\3/g;

/** Return `input` with any secret-shaped substrings replaced by a placeholder. */
export function redactSecrets(input: string): string {
  if (!input) return input;
  let out = input;
  for (const { re, label } of PATTERNS) out = out.replace(re, `[REDACTED_${label}]`);
  out = out.replace(ENV_SECRET, (_m, key, sep) => `${key}${sep}[REDACTED]`);
  return out;
}
